{
  "name": "sema",
  "version": "0.3.0",
  "description": "Viewer-controlled audio description and visual-moment revisiting on Fire TV.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "bundle": "node tools/bundle.js",
    "posters": "node tools/posters.js",
    "webm": "node tools/webm.js",
    "prestart": "node tools/bundle.js",
    "start": "node tools/serve.js",
    "validate": "node tools/validate.js --all",
    "content:fetch": "sh tools/fetch-content.sh",
    "fixture": "AWS_PROFILE=sema pipeline/.venv/bin/python tools/generate-fixture.py && node tools/webm.js",
    "vega:sync": "node tools/vega-sync.js",
    "release:check": "node tools/release-check.js",
    "coverage:recovery": "node tools/recovery-coverage.js --report artifacts/recovery-coverage.md",
    "site": "node tools/build-site.js",
    "preview:build": "node tools/build-preview.js",
    "preview": "npm run preview:build && node tools/serve.js --preview",
    "vega:preview": "npm run preview:build && node tools/vega-sync.js --preview",
    "preview:author": "pipeline/.venv/bin/python tools/build-review-preview.py",
    "baselines": "pipeline/.venv/bin/python tools/build-baselines.py",
    "test:browser": "node tools/test-browser.mjs",
    "repo:check": "node tools/check-repo.js",
    "content:check": "node tools/check-description-levels.js",
    "test:native": "npm --prefix vega-app test -- --runInBand --watchman=false",
    "submission:prepare": "node tools/submission-kit.js --verify"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
